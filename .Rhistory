library(tidyr)
library(dplyr)
library(readxl)
#current document version displayed
ls_metadata = list(last_update = as.Date("2026-03-17"),
current_version = "b0.0.1")
save(ls_metadata,
file = "metadata.rds")
#set all tables to this form
mykable <- function(df){
knitr::kable(df, digits = 2, align = "c", escape = F) %>%
kableExtra::kable_styling(font_size = 12)
}
mykable
readxl::read_xlsx(path = "files\organisation.xlsx")
